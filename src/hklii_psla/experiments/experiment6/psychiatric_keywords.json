{
  "version": 1,
  "description": "Bag-of-words used to detect psychiatric / psychological content in an extraction. When detected, the partial-edit agent ensures a single loss of the target category exists (description taken verbatim from the item's source quotes), while leaving the original (possibly null-ICD) injury entry untouched so injury ids are never renumbered.",
  "target_loss_category": "Personality change",
  "scan": ["injuries", "manifestations"],
  "description_from": "source",
  "one_loss_per_case": true,
  "keywords": [
    "ptsd",
    "post-traumatic stress",
    "post traumatic stress",
    "posttraumatic stress",
    "post-traumatic disorder",
    "post traumatic disorder",
    "posttraumatic disorder",
    "post-traumatic stress disorder",
    "acute stress disorder",
    "stress disorder",
    "adjustment disorder",
    "depression",
    "depressive",
    "depressed mood",
    "major depressive",
    "anxiety",
    "anxious",
    "anxiet",
    "schizophrenia",
    "schizophrenic",
    "psychosis",
    "psychotic",
    "psychiatric",
    "psychiatric disorder",
    "delusional disorder",
    "delusions",
    "bipolar",
    "manic",
    "mood disorder",
    "emotional disorder",
    "personality change",
    "personality disorder",
    "irritability",
    "irritable",
    "mental disorder",
    "mental illness",
    "nervous shock",
    "nervous breakdown",
    "panic attack",
    "panic disorder",
    "obsessive compulsive",
    "somatic symptom",
    "somatoform",
    "conversion disorder",
    "neurotic",
    "hysteria",
    "hysterical"
  ],
  "exclusions": [
    "depressed skull fracture",
    "depressed fracture",
    "depressed skull",
    "post-traumatic stress fracture",
    "post traumatic stress fracture"
  ]
}
